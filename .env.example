# Copy to .env and fill in. Never commit .env.

# Local development (matches docker-compose.yml — host port 5433)
DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5433/meridian

# Production: Supabase Pro connection string (NOT the free tier — it pauses
# after 7 days idle and would silently kill the recorder).
# DATABASE_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres

# Polymarket US credentials — ONLY needed for the executor (build unit 11).
# The entire data layer runs unauthenticated against gateway.polymarket.us.
# Obtain: app account -> identity verification -> polymarket.us/developer -> create key
# POLYMARKET_KEY_ID=
# POLYMARKET_SECRET_KEY=
