# Copy to .env and fill in. Never commit .env.

# Local development (matches docker-compose.yml — host port 5433)
DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5433/meridian

# Production: Supabase Pro connection string (NOT the free tier — it pauses
# after 7 days idle and would silently kill the recorder).
# DATABASE_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres

# Where /api/status reads the LIVE recorder's heartbeat and tick counts (that
# recorder writes to local Postgres, not Supabase — see docs/infra/heartbeats.md).
# Only needed if the local container is somewhere other than the default below.
# MERIDIAN_LOCAL_DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5433/meridian

# Polymarket US credentials — needed for authenticated READS (portfolio,
# balances) and, later, the executor (build unit 11). The entire data layer
# runs unauthenticated against gateway.polymarket.us and needs none of this.
#
# Obtain: app account -> identity verification -> polymarket.us/developer -> create key
# The secret is shown ONCE, at creation. It is a standard-base64 64-byte
# Ed25519 private key (88 chars): bytes 0-31 seed, bytes 32-63 public key.
#
# These two values are the whole scheme. There is NO passphrase and NO signer
# address — those belong to the international CLOB at clob.polymarket.com,
# which is a different venue. See docs/findings.md V9.
# POLYMARKET_KEY_ID=
# POLYMARKET_SECRET_KEY=

# Optional: override the authenticated host (default https://api.polymarket.us)
# POLYMARKET_API_URL=

# Enables the human-confirmed order path. UNSET MEANS ORDERING IS DISABLED —
# POST /api/orders returns 403 when this is absent, so the default deployment
# cannot place orders even with valid Polymarket credentials present.
#
# It is not a login. core/api.py is unauthenticated by design; this is a second
# physical fact the caller must possess, presented as X-Meridian-Order-Token.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Setting this does NOT enable autonomous trading. ExecutionMode stays SHADOW,
# kill_switch stays True, and an accepted order in any mode other than
# HUMAN_CONFIRM is refused by a Postgres CHECK constraint. See findings.md V13.
# MERIDIAN_ORDER_TOKEN=

# --- Kalshi (second venue, read-only) ----------------------------------------
# Public unauthenticated market data. There is deliberately no key variable:
# KalshiConfig has no credential field, so a key has nowhere to go.
# KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_RPS=5
# KALSHI_INTERVAL=60             # poll cadence inside the pregame window
# KALSHI_PREGAME_HOURS=6         # window before tip-off in which 60s polling runs
# KALSHI_INTERVAL_IDLE=900
# KALSHI_DISCOVERY_INTERVAL=21600
# KALSHI_SNAPSHOT_RAW=false      # terms are kept verbatim in kalshi_contracts;
#                                # raw-per-snapshot is quota burn (supabase-quota.md)
