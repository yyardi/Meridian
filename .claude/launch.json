{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "meridian-dashboard-dev",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5433/meridian",
        "MERIDIAN_FILL_WATCHER=0",
        ".venv/bin/uvicorn", "core.api:app", "--host", "127.0.0.1", "--port", "8018"
